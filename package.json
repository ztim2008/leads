{
  "name": "leads.konversus.ru",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:agent-v2": "esbuild src/agent-core/vps-agent.ts --bundle --platform=node --format=esm --outfile=public/agent/v2/agent.bundle.mjs --external:playwright --packages=external",
    "build:agent-youdo": "esbuild src/agent-core/youdo-agent.ts --bundle --platform=node --format=esm --outfile=public/agent/v2/youdo.bundle.mjs --external:playwright --packages=external",
    "build": "npm run build:agent-v2 && npm run build:agent-youdo && next build",
    "start": "next start",
    "lint": "eslint",
    "test:agent-core": "tsx --test src/agent-core/circuit-breaker.test.ts src/agent-core/youdo-collector.test.ts src/lib/connectors/fl.test.ts src/lib/agent/youdo-watch.test.ts src/lib/agent/stale-error.test.ts src/lib/agent/poll-interval.test.ts src/lib/admin/doctor.test.ts src/lib/leads/parse-feed-card.test.ts src/lib/leads/name-gender.test.ts src/lib/leads/partner-filters.test.ts src/lib/leads/ru-stem.test.ts src/lib/leads/reply-templates.test.ts src/lib/billing/operator-pricing.test.ts src/lib/billing/payment-calendar.test.ts src/lib/radar/radar.test.ts",
    "operator": "tsx scripts/operator/cli.ts",
    "operator:parse": "tsx scripts/operator/cli.ts parse",
    "operator:onboard": "tsx scripts/operator/cli.ts onboard",
    "operator:verify": "tsx scripts/operator/cli.ts verify",
    "pokaz:sync": "node scripts/pokaz-sync.mjs",
    "snapshot": "bash scripts/backup-snapshot.sh day-close",
    "client-bridge:deploy": "bash scripts/client-bridge/deploy-to-vps.sh",
    "client-bridge:rsync": "bash scripts/client-bridge/rsync-shared.sh",
    "rentgen:model": "bash scripts/rentgen-fetch-model.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^5.22.0",
    "axe-core": "^4.14.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.78.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "onnxruntime-node": "^1.30.0",
    "pdfkit": "^0.20.2",
    "playwright": "^1.61.0",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yookassa": "^0.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
