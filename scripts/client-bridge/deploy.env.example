# Скопируйте в deploy.env и заполните. Не коммитить.

# --- Общее ---
# variant: vps | shared
DEPLOY_VARIANT=vps

# --- Вариант B: мини-VPS клиента ---
SSH_HOST=203.0.113.10
SSH_USER=deploy
SSH_PORT=22
# Путь к ключу на хабе (пусто = ssh agent / default)
SSH_KEY=

# Каталог приложения на удалённом VPS
REMOTE_DIR=/var/www/client-app

# Имя PM2-процесса и порт
PM2_NAME=client-app
APP_PORT=3010

# Режим синхронизации: git | rsync
SYNC_MODE=git
# Ветка при SYNC_MODE=git
GIT_BRANCH=main

# Локальный каталог при SYNC_MODE=rsync (абсолютный или относительно репо leads)
LOCAL_DIR=

# Команды на удалённой машине (можно переопределить)
REMOTE_INSTALL_CMD="npm ci"
REMOTE_BUILD_CMD="npm run build"
# После билда: reload существующего или start
PM2_RELOAD=1

# --- Вариант C: shared Timeweb/Beget ---
# SSH_HOST / SSH_USER / SSH_PORT — те же
# REMOTE_DIR=/home/user/client.ru/public_html
# LOCAL_DIR=/var/www/www-root/data/www/client-project/out
# RSYNC_DELETE=0
