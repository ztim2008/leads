# Пример .env клиентского сервиса (договор + оплата). Не коммитить реальные значения.

NODE_ENV=production
PORT=3010
HOSTNAME=0.0.0.0

# Публичный URL (домен клиента)
NEXT_PUBLIC_APP_URL=https://example-client.ru

# БД (изолированная на клиента / tenant)
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/client_app

# Сессии / auth
NEXTAUTH_URL=https://example-client.ru
NEXTAUTH_SECRET=change-me-long-random

# Эквайринг (пример ЮKassa) — webhook: https://example-client.ru/api/payments/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example-client.ru/pay/success

# Опционально: почта уведомлений
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@example-client.ru
